<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<VBox spacing="10"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="CoursesController">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

<Label text ="Course Management"/>

<TableView fx:id="courseTable">

<columns>
    <TableColumn fx:id="courseIdColumn"
                 text="Course ID"/>

    <TableColumn fx:id="courseNameColumn"
                 text="Course Name"/>

    <TableColumn fx:id="teacherIdColumn"
                 text="Teacher ID"/>
</columns>

</TableView>

<Label text="Course Name"/>

<TextField fx:id="courseNameField"
           promptText="Enter course name"/>

<Label text="Teacher ID"/>

<TextField fx:id="teacherIdField"
           promptText="Enter teacher ID"/>

<Button fx:id="addButton"
        text="Add Course"/>

<Button fx:id="deleteButton"
        text="Delete Course"/>

<Button fx:id="updateButton"
        text="Update Course"/>

</VBox>
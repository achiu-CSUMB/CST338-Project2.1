<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<?import javafx.scene.layout.HBox?>
<VBox spacing="10"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="CoursesController">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

<HBox alignment="CENTER_LEFT">
    <Button
        fx:id="backButton"
        text="← Back"
        onAction="#goBackToLogin"/>
</HBox>

<Label text ="Course Management"/>

<TableView fx:id="courseTable">

<columns>
    <TableColumn
        fx:id="instructorColumn"
        text="Instructor"
        prefWidth="170"/>

    <TableColumn fx:id="courseIdColumn"
                 text="Course ID"
                 prefWidth="90"/>

    <TableColumn fx:id="courseNameColumn"
                 text="Course Name"
                 prefWidth="150"/>

    <TableColumn fx:id="capacityColumn"
                 text="Capacity"
                 prefWidth="110"/>
</columns>

</TableView>

<Label text="Course Name"/>

<TextField fx:id="courseNameField"
           promptText="Enter course name"/>

<Label text="Capacity"/>
<TextField fx:id="capacityField"
            promptText="Enter capacity"/>

<Label text="Instructor Prefix"/>

<TextField
    fx:id="prefixField"
    promptText="Dr., Prof., Mr., Ms."/>

<Label text="Instructor Name"/>

<TextField
    fx:id="teacherNameField"
    promptText="John Smith"/>

<Button fx:id="addButton"
        text="Add Course"/>

<Button fx:id="deleteButton"
        text="Delete Course"/>

<Button fx:id="updateButton"
        text="Update Course"/>

</VBox>
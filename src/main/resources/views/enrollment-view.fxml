<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.geometry.Insets?>

<?import javafx.scene.text.Font?>
<VBox spacing="10"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.EnrollmentController">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <HBox alignment="CENTER_LEFT">
        <Button
                fx:id="backButton"
                text="← Back"
                onAction="#goBackToLogin"/>
    </HBox>

    <Label text ="Enrollment Management">
    <font>
        <Font name="System Bold" size="16"/>
    </font>
</Label>

    <Label text="Available Courses"/>

    <TableView fx:id="availableCoursesTable"
               id="availableCoursesTable"
               prefHeight="200">

        <columns>
            <TableColumn fx:id="availableCourseNameColumn"
                         text="Course Name"
                         prefWidth="200"/>

            <TableColumn fx:id="availableCourseInstructorColumn"
                         text="Instructor"
                         prefWidth="200"/>

            <TableColumn fx:id="availableCourseCapacityColumn"
                         text="Capacity"
                         prefWidth="90"/>

        </columns>

    </TableView>

<HBox spacing="10">

    <Button fx:id="enrollButton"
            id="enrollButton"
            text="Enroll"/>

    <Button fx:id="dropButton"
            id="dropButton"
            text="Drop"/>
</HBox>

<Label text="Your Enrollments">
    <font>
        <Font name="System Bold" size="16"/>
    </font>
</Label>

    <TableView fx:id="enrollmentTable"
               id="enrollmentTable"
                prefHeight="200">


        <columns>
            <TableColumn fx:id="courseNameColumn"
            text="Course Name"
            prefWidth="200"/>

            <TableColumn fx:id="statusColumn"
                         text="Status"
                         prefWidth="150"/>

        </columns>

    </TableView>

</VBox>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.geometry.Insets?>

<VBox spacing="10"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.EnrollmentController">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <HBox alignment="CENTER_LEFT">
        <Button
                fx:id="backButton"
                text="← Back"
                onAction="#goBackToLogin"/>
    </HBox>

    <Label text ="model.Enrollment Management"/>

    <Label text="Available Courses"/>

    <TableView fx:id="availableCoursesTable"
               id="availableCoursesTable"
               prefHeight="200">

        <columns>
            <TableColumn fx:id="availableCourseIdColumn"
                         text="model.Course ID"/>

            <TableColumn fx:id="availableCourseNameColumn"
                         text="model.Course Name"/>

        </columns>

    </TableView>

    <Label text="Student ID"/>

    <TextField fx:id="studentIdField"
               id="studentIdField"
               promptText="Enter student ID"/>

<HBox spacing="10">

    <Button fx:id="enrollButton"
            id="enrollButton"
            text="Enroll"/>

    <Button fx:id="dropButton"
            id="dropButton"
            text="Drop"/>
</HBox>

    <TableView fx:id="enrollmentTable"
               id="enrollmentTable"
                prefHeight="200">


        <columns>
            <TableColumn fx:id="enrollmentIdColumn"
                         text="model.Enrollment ID"
                         prefWidth="90"/>

            <TableColumn fx:id="studentIdColumn"
                         text="Student ID"
                         prefWidth="90"/>

            <TableColumn fx:id="courseIdColumn"
                         text="model.Course ID"
                         prefWidth="90"/>

            <TableColumn fx:id="courseNameColumn"
                         text="model.Course Name"
                         prefWidth="90"/>

            <TableColumn fx:id="statusColumn"
                         text="Status"
                         prefWidth="130"/>

        </columns>

    </TableView>

</VBox>